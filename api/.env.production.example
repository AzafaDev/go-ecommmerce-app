# Copy this to `.env` in the same directory as docker-compose.prod.yml on the
# VPS, fill in real values, then `chmod 600 .env`. Never commit the real file.
#
# This file is loaded two ways: (1) docker compose reads it automatically for
# ${VAR} substitution in docker-compose.prod.yml, and (2) it's bind-mounted
# straight into the api container at /app/.env, since the app's config loader
# requires a physical .env file to exist (see internal/config/config.go).

APP_ENV=production
PORT=8080

# Same value used in both places below — docker compose needs it standalone
# for the db service, and it's repeated inside DATABASE_URL for the app.
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-password@db:5432/goecommercedb?sslmode=disable

REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_ADDR=redis:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Mxxxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=noreply@yourdomain.com

# Exact deployed frontend origin — CORS only allows this one origin
# (internal/config/config.go -> AllowedOrigins), no trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app
